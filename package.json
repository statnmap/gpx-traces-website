{
  "name": "gpx-traces-website",
  "version": "1.1.2",
  "description": "A website to display GPX traces on an interactive map",
  "main": "scripts/map.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "build": "webpack --config webpack.config.js",
    "start": "webpack serve --config webpack.config.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage",
    "test:ui": "node tests/ui/smoke.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "generate-docs": "jsdoc -c jsdoc.json"
  },
  "author": "statnmap",
  "license": "MIT",
  "dependencies": {
    "diacritics": "^1.3.0",
    "googleapis": "^182.0.0",
    "leaflet": "^1.9.4",
    "proj4": "^2.22.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@eslint/js": "^10.0.1",
    "@turf/turf": "^7.4.0",
    "babel-jest": "^30.5.2",
    "babel-loader": "^10.1.0",
    "babel-preset-jest": "^30.5.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "dotenv": "^18.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "jsdoc": "^4.0.4",
    "monocart-coverage-reports": "^2.13.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "jest": {
    "collectCoverageFrom": [
      "scripts/**/*.{js,jsx}",
      "!scripts/map.js"
    ]
  }
}
