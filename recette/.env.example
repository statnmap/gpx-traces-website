# Copier ce fichier en `.env` (jamais commité) et renseigner les valeurs. Toutes les valeurs ci-dessous sont VIDES.
# Un mot de passe contenant `#` ou `$` doit être mis entre apostrophes ('…'), sinon dotenv le tronque.
# Un dossier de recette = un projet : un Front et son back-office, un seul jeu de variables.
#
# --- Garde-fous (non secrets) ---
# Motifs d'hôte autorisés pour toute navigation et pour la détection d'URL dans les commits (liste séparée par
# des virgules). Vide = défaut `preprod,pp-`.
RECETTE_ALLOWED_HOST_PATTERNS=
# Domaines d'email autorisés dans les commits (liste séparée par des virgules). Vide = commit-msg n'autorise que
# `anthropic.com` (trailer Co-Authored-By) et pre-commit n'autorise aucun email. Si renseigné, y inclure
# `anthropic.com` pour garder ce trailer.
RECETTE_ALLOWED_EMAIL_DOMAINS=
# Masque les URL dans les rapports (utile en CI).
RECETTE_CI=
#
# --- Front ---
RECETTE_URL=
#
# Affiche le navigateur pendant `login-preprod.mjs`.
RECETTE_HEADED=
# Numéro de départ du suffixe de traçabilité des données de test `recette-AAAAMMJJ-n` (défaut 1 ; l'incrémenter si la
# recette est rejouée le même jour).
RECETTE_RUN_INDEX=
# Autorise `session.capture()` sur le back-office (refusé par défaut). Uniquement pour un back-office de données fictives,
# ET seulement si la section « Masquer aux captures » de config/backoffice/selectors.md déclare au moins un sélecteur
# (le masquage ne cache QUE ce qui est déclaré ; relire chaque capture avant de la partager).
RECETTE_ALLOW_BO_CAPTURE=
# Fenêtre partagée : `1` = le runner se connecte (CDP) à la fenêtre lancée par `node src/recette-window.mjs start`, que
# l'utilisateur a déjà connectée lui-même (2FA/SSO compris, aucun identifiant stocké). Prioritaire sur la connexion
# automatique et sur outputs/.auth/*.json (rien n'est lu ni écrit) ; la fenêtre n'est jamais fermée par le runner (seul
# l'onglet du run) ; erreur claire si elle n'est pas lancée ou pas connectée. Les identifiants HTTP Basic ci-dessus ne
# s'appliquent PAS à la fenêtre (les saisir dans la fenêtre). Front et back-office partagent alors la même fenêtre.
RECETTE_USE_WINDOW=
# Port de la fenêtre partagée `recette-window.mjs` (défaut 9333).
RECETTE_WINDOW_PORT=
# Délai (ms) des navigations et attentes de page du runner (défaut 30000). L'attente « réseau inactif » est faite au
# mieux : un délai dépassé alors que la page est chargée ne fait pas échouer ; les attentes de sélecteurs restent strictes.
RECETTE_NAV_TIMEOUT_MS=
